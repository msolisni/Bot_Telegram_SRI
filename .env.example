# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=Sri_DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Moises1996

# ── Ollama ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── SRI (Servicio de Rentas Internas – Ecuador) ───────────────────
# URL de la API real o mock del SRI
SRI_API_URL=https://srienlinea.sri.gob.ec/sri-catastro-sujeto-servicio-internet/rest
SRI_API_KEY=tu_clave_api_sri   # si aplica

# ── RAG / ChromaDB ────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=documentos_empresa

# ── Servidor MCP ─────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000
